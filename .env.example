# === Telegram ===
BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
# ID админов через запятую (узнать можно через @userinfobot)
ADMIN_IDS=123456789,987654321
# Супер-админ (может добавлять/удалять админов через бота). Если не указан — первый из ADMIN_IDS
SUPERADMIN_ID=123456789

# === 3X-UI Панель ===
# URL панели БЕЗ слеша в конце. Пример: https://vpn.example.com:2053/abc123
PANEL_URL=https://your-panel.com:2053/panel_path
PANEL_USERNAME=admin
PANEL_PASSWORD=your_password
# ID инбаунда по умолчанию (если пусто — бот предложит выбрать)
DEFAULT_INBOUND_ID=

# Мульти-панели (опционально): если у тебя несколько серверов — заполни так:
# PANELS_JSON='[{"name":"🇩🇪 DE-1","url":"https://de1.example.com:2053/xxx","username":"admin","password":"pass","default_inbound_id":1},{"name":"🇫🇮 FI-1","url":"https://fi1.example.com:2053/xxx","username":"admin","password":"pass"}]'
# Если PANELS_JSON задан — PANEL_URL/PANEL_USERNAME/PANEL_PASSWORD игнорируются
PANELS_JSON=

# === Настройки бота ===
# Префикс для email клиента (будет bot_username-имя)
# Дни по умолчанию при создании
DEFAULT_EXPIRE_DAYS=30
# Трафик по умолчанию в ГБ (0 = безлимит)
DEFAULT_TRAFFIC_GB=0

# === База ===
# путь к sqlite (хранит админов, кэш)
DB_PATH=data/bot.db
